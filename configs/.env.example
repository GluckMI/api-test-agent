# ============================================================
# API Test Agent - 环境变量模板文件 (.env)
# ============================================================
# 
# ⚠️ 重要提示：
# 1. 不要将此文件提交到 Git 版本控制系统
# 2. 复制此文件为 .env 并填入真实的敏感信息
# 3. 此文件仅用于本地开发环境
#
# 使用方法：
#   cp .env.example .env
#   vim .env  # 编辑并填入真实值
#
# 支持的格式：
# - KEY=VALUE（简单键值对）
# - KEY="VALUE"（带双引号的值）
# - KEY='VALUE'（带单引号的值）
# - # 注释行（以 # 开头）
# - 空行（会被忽略）
# ============================================================

# ---------- API 认证相关 ----------
# API 密钥（用于接口认证）
API_KEY=your_api_key_here

# API 密钥前缀（如 Bearer、sk_live_ 等）
AUTH_PREFIX=Bearer

# OAuth2 Access Token（如果使用 OAuth2 认证）
# OAUTH_ACCESS_TOKEN=your_oauth_token_here

# ---------- 数据库相关 ----------
# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=5432

# 数据库名称
DB_NAME=testdb

# 数据库用户名
DB_USERNAME=admin

# 数据库密码
DB_PASSWORD=your_db_password_here

# Redis 连接地址
REDIS_URL=redis://localhost:6379

# ---------- 第三方服务 ----------
# 邮件服务 API Key
MAILGUN_API_KEY=your_mailgun_key

# 短信服务 API Key
SMS_API_KEY=your_sms_key

# 对象存储 Secret Key
OSS_SECRET_KEY=your_oss_secret

# ---------- 测试专用 ----------
# 测试管理员账号
TEST_ADMIN_USERNAME=admin

# 测试管理员密码
TEST_ADMIN_PASSWORD=admin123456

# 测试普通用户账号
TEST_USER_USERNAME=testuser

# 测试普通用户密码
TEST_USER_PASSWORD=user123456

# 是否启用调试模式（true/false）
DEBUG_MODE=true

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=DEBUG

# ---------- 自定义变量 ----------
# 可以添加任何项目需要的自定义变量
CUSTOM_VAR=value
