# ============================================================
# API Test Agent - Staging 环境变量模板 (.env.staging)
# ============================================================
# 
# ⚠️ 重要提示：
# 1. 不要将此文件提交到 Git 版本控制系统
# 2. 复制此文件为 .env.staging 并填入 staging 环境的真实值
# 3. 此文件会被 environments.yaml 的 staging 环境自动加载
#
# 使用方法：
#   cp .env.staging.example .env.staging
#   vim .env.staging  # 编辑并填入真实值
# ============================================================

# ---------- Staging 环境 API 认证 ----------
STAGING_API_KEY=sk_staging_your_api_key_here

# Staging 环境的数据库凭证
STAGING_DB_HOST=db.staging.example.com
STAGING_DB_PORT=5432
STAGING_DB_NAME=staging_db
STAGING_DB_USERNAME=staging_admin
STAGING_DB_PASSWORD=staging_password_here

# Staging 环境的 Redis
STAGING_REDIS_URL=redis://staging-redis.example.com:6379

# ---------- 第三方服务（Staging 环境） ----------
STAGING_MAILGUN_API_KEY=staging_mailgun_key
STAGING_SMS_API_KEY=staging_sms_key

# ---------- Staging 测试账号 ----------
STAGING_TEST_ADMIN_USERNAME=staging_admin
STAGING_TEST_ADMIN_PASSWORD=staging_admin_pass
STAGING_TEST_USER_USERNAME=staging_user
STAGING_TEST_USER_PASSWORD=staging_user_pass

# Staging 特有变量
STAGING_DEBUG_MODE=false
STAGING_LOG_LEVEL=INFO
